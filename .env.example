# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///jobhelper.db

# SMTP Configuration for Real Email OTP Authentication
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER="JobHelper AI" <your-email@gmail.com>

# Security & OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes

# Optional OpenAI / LLM Configuration (Application works 100% locally without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
